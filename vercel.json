{
  "functions": {
    "api/data/[type].js": {
      "includeFiles": "{Models/models.json,videos.json,banner.json,marquee.json,member-Afi-Studio/member.json,ranking/ranking.json,categories.json,app-categories.json,settings.json,surveys.json}"
    },
    "api/survey-page.js": {
      "includeFiles": "survey/template.html"
    },
    "api/model-submit.js": {
      "maxDuration": 30
    },
    "api/feedback.js": {
      "maxDuration": 30
    },
    "api/survey-submit.js": {
      "maxDuration": 30
    },
    "api/telegram-webhook.js": {
      "maxDuration": 60
    },
    "api/cron/pending-reminder.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    { "path": "/api/cron/pending-reminder", "schedule": "0 9 * * *" }
  ],
  "rewrites": [
    { "source": "/survey", "destination": "/api/survey-page" },
    { "source": "/survey/", "destination": "/api/survey-page" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(icon.png|icon-192.png|icon-maskable.png|favicon.png|thumbnail.webp|Banner1.webp|Banner2.webp|Banner3.webp|Banner4.webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/member-Afi-Studio/profile/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(videos.json|Models/models.json|member-Afi-Studio/member.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
